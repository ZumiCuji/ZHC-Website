<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<title>Mission Control | ZHC Projects</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

:root{
    --bg:#020611;
    --panel:#07111f;
    --cyan:#73e7ff;
    --blue:#2a8fff;
    --text:#d9f4ff;
    --muted:#89a8c0;
    --border:rgba(0,255,255,0.12);
}

body{
    font-family:'Inter',sans-serif;
    background:var(--bg);
    color:white;
    overflow-x:hidden;
    position:relative;
}

/* BACKGROUND */

.bg{
    position:fixed;
    inset:0;
    z-index:-10;
    overflow:hidden;
}

.grid{
    position:absolute;
    inset:0;
    background:
        linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size:60px 60px;
    opacity:0.05;
}

.stars{
    position:absolute;
    inset:0;
    background-image:
        radial-gradient(white 1px, transparent 1px),
        radial-gradient(rgba(255,255,255,0.7) 1px, transparent 1px);
    background-size:140px 140px, 70px 70px;
    opacity:0.18;
}

.glow{
    position:absolute;
    width:800px;
    height:800px;
    border-radius:50%;
    background:radial-gradient(circle, rgba(0,170,255,0.12), transparent 70%);
    filter:blur(40px);
}

.glow.one{
    top:-200px;
    left:-200px;
}

.glow.two{
    bottom:-300px;
    right:-200px;
}

/* NAV */

.nav{
    width:100%;
    padding:24px 7%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-bottom:1px solid rgba(255,255,255,0.05);
    backdrop-filter:blur(18px);
    position:sticky;
    top:0;
    z-index:100;
}

.logo{
    font-size:1.2rem;
    font-weight:800;
    letter-spacing:4px;
    color:var(--cyan);
    text-shadow:0 0 25px rgba(0,255,255,0.35);
}

.nav-links{
    display:flex;
    gap:32px;
}

.nav-links a{
    color:#9cb7cc;
    text-decoration:none;
    transition:0.3s;
    font-size:0.95rem;
}

.nav-links a:hover{
    color:var(--cyan);
}

/* HERO */

.hero{
    min-height:92vh;
    width:100%;
    padding:120px 7% 80px;
    display:grid;
    grid-template-columns:1.1fr 1fr;
    gap:70px;
    align-items:center;
}

.eyebrow{
    color:var(--cyan);
    letter-spacing:4px;
    font-size:0.8rem;
    margin-bottom:18px;
}

.hero h1{
    font-size:5.3rem;
    line-height:0.95;
    letter-spacing:-4px;
    margin-bottom:26px;
}

.hero h1 span{
    color:var(--cyan);
    text-shadow:0 0 30px rgba(0,255,255,0.35);
}

.hero p{
    color:var(--muted);
    font-size:1.05rem;
    line-height:1.9;
    max-width:700px;
}

.hero-buttons{
    display:flex;
    gap:18px;
    margin-top:40px;
    flex-wrap:wrap;
}

.btn{
    padding:16px 28px;
    border-radius:16px;
    text-decoration:none;
    font-weight:600;
    transition:0.3s;
}

.primary{
    background:linear-gradient(135deg,#00c6ff,#005eff);
    color:white;
    box-shadow:0 0 40px rgba(0,140,255,0.35);
}

.primary:hover{
    transform:translateY(-4px);
}

.secondary{
    border:1px solid rgba(255,255,255,0.08);
    color:#b9d4e7;
    background:rgba(255,255,255,0.03);
}

.secondary:hover{
    border-color:rgba(0,255,255,0.25);
    color:var(--cyan);
}

/* PREVIEW PANEL */

.preview{
    position:relative;
}

.dashboard-card{
    background:rgba(7,17,31,0.92);
    border:1px solid var(--border);
    border-radius:32px;
    overflow:hidden;
    box-shadow:
        0 0 40px rgba(0,170,255,0.12),
        inset 0 0 100px rgba(255,255,255,0.02);
}

.dashboard-top{
    display:flex;
    justify-content:space-between;
    padding:18px 22px;
    border-bottom:1px solid rgba(255,255,255,0.05);
}

.dot-group{
    display:flex;
    gap:8px;
}

.dot{
    width:10px;
    height:10px;
    border-radius:50%;
}

.red{background:#ff5f57;}
.yellow{background:#ffbd2f;}
.green{background:#28ca42;}

.live{
    color:#43ffb1;
    font-size:0.75rem;
    letter-spacing:2px;
}

.dashboard-image{
    width:100%;
    height:520px;
    object-fit:cover;
    display:block;
    opacity:0.92;
}

/* CONTENT */

.section{
    padding:90px 7%;
}

.section-title{
    color:var(--cyan);
    letter-spacing:4px;
    font-size:0.8rem;
    margin-bottom:18px;
}

.section h2{
    font-size:3rem;
    margin-bottom:24px;
}

.section-desc{
    color:var(--muted);
    max-width:850px;
    line-height:1.9;
}

/* CARDS */

.card-grid{
    margin-top:48px;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:24px;
}

.card{
    background:rgba(7,17,31,0.88);
    border:1px solid var(--border);
    border-radius:28px;
    padding:32px;
    transition:0.35s;
    position:relative;
    overflow:hidden;
}

.card::before{
    content:'';
    position:absolute;
    inset:0;
    background:linear-gradient(
        135deg,
        rgba(0,180,255,0.08),
        transparent 40%
    );
    opacity:0;
    transition:0.4s;
}

.card:hover::before{
    opacity:1;
}

.card:hover{
    transform:translateY(-8px);
    border-color:rgba(0,255,255,0.25);
}

.icon{
    width:60px;
    height:60px;
    border-radius:18px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:1.5rem;
    margin-bottom:22px;
    background:rgba(0,170,255,0.08);
    border:1px solid rgba(0,255,255,0.12);
}

.card h3{
    color:var(--cyan);
    margin-bottom:18px;
    font-size:1.2rem;
}

.card p{
    color:#9ab8ce;
    line-height:1.85;
    font-size:0.96rem;
}

/* TIMELINE */

.timeline{
    margin-top:60px;
    display:flex;
    flex-direction:column;
    gap:28px;
}

.timeline-item{
    display:flex;
    gap:24px;
    align-items:flex-start;
}

.timeline-number{
    width:58px;
    height:58px;
    border-radius:18px;
    background:rgba(0,170,255,0.08);
    border:1px solid rgba(0,255,255,0.12);
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--cyan);
    font-weight:700;
    flex-shrink:0;
}

.timeline-content{
    background:rgba(7,17,31,0.88);
    border:1px solid var(--border);
    border-radius:24px;
    padding:28px;
    width:100%;
}

.timeline-content h4{
    margin-bottom:10px;
    color:white;
    font-size:1.1rem;
}

.timeline-content p{
    color:#96b3c8;
    line-height:1.8;
}

/* FOOTER */

.footer{
    padding:40px 7%;
    border-top:1px solid rgba(255,255,255,0.05);
    display:flex;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:20px;
    color:#7291a8;
}

/* RESPONSIVE */

@media(max-width:1100px){

    .hero{
        grid-template-columns:1fr;
    }

    .hero h1{
        font-size:4rem;
    }

    .card-grid{
        grid-template-columns:1fr;
    }
}

@media(max-width:700px){

    .nav{
        flex-direction:column;
        gap:20px;
    }

    .nav-links{
        flex-wrap:wrap;
        justify-content:center;
    }

    .hero h1{
        font-size:3rem;
    }

    .section h2{
        font-size:2.2rem;
    }

    .dashboard-image{
        height:340px;
    }
}

</style>
</head>
